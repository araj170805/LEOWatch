# ── Database ────────────────────────────────────────────────
# Leave blank to use a local SQLite file (backend/orbital_guardian.db).
DATABASE_URL=postgresql://user:password@localhost:5432/orbital_guardian

# ── Auth ────────────────────────────────────────────────────
# Local JWT fallback (used only when Supabase is not configured).
JWT_SECRET_KEY=change-me-generate-random
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Supabase verifies frontend sessions. SUPABASE_JWT_SECRET only needed for
# projects still signing tokens with the legacy HS256 shared secret.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_JWT_SECRET=

# Comma-separated allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── CelesTrak (orbital element source) ──────────────────────
CELESTRAK_BASE_URL=https://celestrak.org/NORAD/elements/gp.php
CELESTRAK_CACHE_TTL=3600

# ── AI: Google Gemini (explanation layer only) ──────────────
# Never expose these in the frontend. Gemini only explains pre-computed
# numbers; it never calculates orbits, TCA, distance or risk.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-004

# ── Optional: OpenAI-compatible fallback LLM (e.g. Groq) ────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
